# Puerto del servidor (Render lo define automáticamente)
PORT=3000
# development | production
NODE_ENV=development

# Conexión a PostgreSQL
# En Render (servicio web): usar la "Internal Database URL"
# Desde tu PC (db:init / db:seed contra Render): usar la "External Database URL" y DB_SSL=true
DATABASE_URL=postgresql://usuario:password@host:5432/seguria_lpr
# true si la BD exige SSL (Render externo). false para PostgreSQL local
DB_SSL=false

# Firma de los tokens JWT. Usa un valor largo y aleatorio
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Origen permitido por CORS (URL del frontend). Puedes poner varias separadas por coma
FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500

# Cloudinary (imágenes de capturas). Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
